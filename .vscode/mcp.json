{
    "inputs": [
        {
            "type": "promptString",
            "id": "functions-mcp-extension-system-key",
            "description": "Azure Functions MCP Extension System Key",
            "password": true,
			"default": "gYBP-T-7slGyuSEgEOCnwA4AXvag65liE0kjChC4HbgLAzFuoJud_A=="
        },
        {
            "type": "promptString",
            "id": "functionapp-name",
            "description": "Azure Functions App Name",
			"default": "function-app-mcp-600"
        }
    ],
    "servers": {
        "remote-mcp-server-function": {
            "type": "http",
            "url": "https://${input:functionapp-name}.azurewebsites.net/runtime/webhooks/mcp",
            "headers": {
                "x-functions-key": "${input:functions-mcp-extension-system-key}"
            }
        },
        "local-mcp-server-function": {
            "type": "http",
            "url": "http://0.0.0.0:7071/runtime/webhooks/mcp"
        }
    }
}