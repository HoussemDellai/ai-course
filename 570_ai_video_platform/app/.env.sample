# Copy to .env to run the orchestrator locally (python main.py). Values come from `terraform output`.
FOUNDRY_PROJECT_ENDPOINT=https://foundry-aivideo570.services.ai.azure.com/api/projects/project-aivideo570
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-6-astra
SPEECH_ENDPOINT=https://foundry-aivideo570.cognitiveservices.azure.com/
TTS_VOICE=en-US-AndrewMultilingualNeural
# Reach the private ComfyUI through an SSH tunnel: ssh -L 8188:localhost:8188 azureuser@<vm_public_ip>
COMFYUI_URLS=http://<vm_public_ip>:8188
# Live GPU utilisation in the web UI (terraform output gpu_stats_url). Leave empty to hide it.
GPU_STATS_URLS=http://<vm_public_ip>:8189
DEFAULT_VIDEO_MODEL=wan22
# Leave empty to store jobs and videos in ./output instead of Blob Storage
STORAGE_ACCOUNT_URL=
STORAGE_CONTAINER=videos
# Leave empty to disable the API key check locally
API_KEY=
