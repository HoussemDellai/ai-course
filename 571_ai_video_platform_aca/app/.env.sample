# Copy to .env to run the orchestrator locally (python main.py). Values come from `terraform output`.
FOUNDRY_PROJECT_ENDPOINT=https://foundry-aivideo571.services.ai.azure.com/api/projects/project-aivideo571
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-6-astra
# Educational narration explicitly uses Speech REST over HTTPS at this custom endpoint.
# Cinematic narration retains the Speech SDK default; no automatic transport fallback.
SPEECH_ENDPOINT=https://foundry-aivideo571.cognitiveservices.azure.com/
TTS_VOICE=en-US-AndrewMultilingualNeural
# Join terraform output comfyui_urls with commas (one URL when comfyui_worker_count=1).
# Each URL must identify a separate one-replica app, not load-balanced ComfyUI replicas.
COMFYUI_URLS=https://<primary-comfyui-fqdn>,https://<secondary-comfyui-fqdn>
# Same URLs from gpu_stats_urls; the extension serves /gpu_stats. Leave empty to hide telemetry.
GPU_STATS_URLS=https://<primary-comfyui-fqdn>,https://<secondary-comfyui-fqdn>
DEFAULT_VIDEO_MODEL=wan22
# Leave empty to store jobs and videos in ./output instead of Blob Storage
STORAGE_ACCOUNT_URL=
STORAGE_CONTAINER=videos
# Leave empty to disable the API key check locally
API_KEY=
# Largest reference photo accepted by POST /api/videos (multipart 'image'), in MB
MAX_IMAGE_MB=50
# Document-to-video (.pdf / .pptx), independent of reference-photo limits.
MAX_DOCUMENT_MB=100
# Executable name or full path; required only for PowerPoint conversion.
LIBREOFFICE_PATH=soffice
# Background music (request field "music"): linear volume under the scene audio, and fade at each scene cut
MUSIC_VOLUME=0.3
MUSIC_FADE_SECONDS=1.0

# Educational/presentation generation (opt-in; planning pauses for explicit approval).
# Additional compatible text deployment names, comma-separated. The default above is also available.
# These are text models, not a claim that Claude/MAI/GPT families all generate images or video.
EDUCATION_TEXT_MODELS=
# Deployment supporting the implemented public web-search tool; required for grounded planning.
# Only the request's explicit public_topic is searched. Never put private information in that topic.
EDUCATION_SEARCH_MODEL=
# Optional verified image/video modality endpoints and deployment names, not chat deployments.
FOUNDRY_IMAGE_ENDPOINT=
FOUNDRY_IMAGE_MODEL=
FOUNDRY_VIDEO_ENDPOINT=
FOUNDRY_VIDEO_MODEL=
# Private self-hosted draw.io Streamable HTTP /mcp endpoint and installed headless export command.
# Diagram graphs use native shapes; exported PNG previews are served, never raw SVG in the UI.
DRAWIO_MCP_URL=
# Native production image (Dockerfile.education) default:
# DRAWIO_EXPORT_COMMAND=["python","/app/drawio_runtime/export_native.py"]
# Export runs inside the application container; no host Docker socket in production.
DRAWIO_EXPORT_COMMAND=
# Path to a compatible ComfyUI text-to-image API workflow JSON (not the reference-photo edit workflow).
# Required input placeholders: {{prompt}}, {{width}}, {{height}}, {{seed}}, {{filename_prefix}}; no {{image}}.
# Supplied graph: app\video_platform\comfy_workflows\qwen_image_t2i.json (Qwen-Image FP8, 20 steps, CFG 4).
# Production image default: /app/video_platform/comfy_workflows/qwen_image_t2i.json
# Requires qwen_image_fp8_e4m3fn.safetensors; the GPU model script downloads it only with
# DOWNLOAD_EDUCATION_IMAGES=1 and verifies its pinned SHA-256. Encoder/VAE reuse existing Qwen assets.
COMFY_IMAGE_WORKFLOW=
# Local TrueType/OpenType font path used for educational labels; ensure it is readable and licensed.
# Production image default: /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
EDUCATION_FONT=
# Optional base URL used by generate.py draft/update/approve/regenerate (same API_KEY as above).
VIDEO_API_URL=http://localhost:8000
